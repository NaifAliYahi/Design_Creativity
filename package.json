{
  "name": "cs-operations-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run server\" \"vite\"",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "web": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node scripts/copy-404.mjs",
    "build:netlify": "npm run prepare:netcard-data && npm run build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "sync:templates": "node scripts/sync-templates.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "export:layouts": "node scripts/export-bundled-layouts.mjs",
    "sync:odoo-layouts": "node scripts/sync-layouts-from-odoo.mjs",
    "verify:layouts": "node scripts/verify-layouts.mjs",
    "merge:bundled": "node scripts/merge-odoo-layouts-to-bundled.mjs",
    "prepare:netcard-data": "npm run sync:odoo-layouts && npm run merge:bundled && npm run verify:layouts",
    "package:server": "node scripts/package-server.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "idb": "^8.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
